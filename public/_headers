/*
  Security headers for every static file (landing, admin, dashboard).
  Keep in sync with functions/_middleware.js, which covers the API routes.
  CSP allows inline script/style because the pages use inline <script> and
  <style>; everything fetched is same-origin, so 'self' covers it all.
*/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
